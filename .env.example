# 复制为 .env 后修改；密钥只由服务端读取，不能加 VITE_ 前缀。
PORT=4318
HOST=127.0.0.1
DEMO_MODE=true
# AI 服务商（OpenAI 兼容接口即可：官方 /chat/completions + Bearer 认证）。
# AI_API_KEY 只在服务端进程内读取，绝不发给浏览器。旧名 DEEPSEEK_API_KEY 仍作别名有效。
AI_API_KEY=
# 默认 https://api.deepseek.com；换成任意兼容服务商（OpenAI、通义、智谱、自建 vLLM 等）即可。
# 公网地址必须 HTTPS；本机或内网自建服务可用 http://127.0.0.1:端口/v1 自测。
AI_BASE_URL=https://api.deepseek.com
# 默认 deepseek-v4-flash；旧名 DEEPSEEK_MODEL 仍作别名有效。
AI_MODEL=deepseek-v4-flash
STORE_NAME=Sunny Tea House
STORE_CITY=San Jose
# Google 商家后台“索取评价”链接，例如 https://g.page/r/真实商家ID/review；留空则默认跳 Google 地图搜索该店。
GOOGLE_REVIEW_URL=
# 这里只是平台入口，无法保证直接唤起笔记编辑器，也不会自动发布。
XIAOHONGSHU_URL=https://www.xiaohongshu.com/
# 默认关闭；开启后会把生成初稿发至你配置的群。不要把 Webhook URL 提交到版本库。
ENABLE_WECHAT_NOTIFY=false
WECHAT_WEBHOOK_URL=
